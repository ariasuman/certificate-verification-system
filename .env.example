# Flask session signing key: replace with a long random value, never commit .env
APP_SECRET_KEY=replace-with-a-long-random-secret

# Required for S3 storage
S3_BUCKET=your-private-certificate-bucket
AWS_REGION=us-east-1

# For local development only, use a least-privilege IAM user or an AWS profile.
# EC2 should use an attached IAM instance role; do not add static credentials there.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: gate the shared student demonstration. Set this on Render/production.
DEMO_ACCESS_CODE=replace-with-a-private-demo-code

# Optional: configure a non-default SQLite location, e.g. a Render persistent disk.
# DATABASE_PATH=/var/data/certificates.sqlite3

# Windows example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# Linux usually discovers /usr/bin/tesseract automatically.
# TESSERACT_CMD=
